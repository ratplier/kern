--!strict

const file_system = require("@std/fs")
const path = require("@std/path")

const OUTPUT_PATH = "src/cli/gen/modules.luau"

const function read_version()
	const version = file_system.readFileToString("VERSION"):gsub("^%s+", ""):gsub("%s+$", "")
	if version:match("^%d+%.%d+%.%d+[%w%.%-]*$") == nil then
		error(`kern: VERSION must contain a semantic version, got '{version}'`)
	end
	return version
end

const VERSION = read_version()

const function normalized(value): string
	const result = path.format(path.normalize(value)):gsub("\\", "/")
	return result
end

const function quote(source: string): string
	local equals = ""
	while source:find(`]{equals}]`, 1, true) ~= nil do
		equals ..= "="
	end
	return `[{equals}[{source}]{equals}]`
end

const function collect(directory: string, files: { string })
	for _, entry in file_system.listDirectory(directory) do
		const file_path = normalized(path.join(directory, entry.name))
		if entry.type == "dir" then
			collect(file_path, files)
		elseif entry.type == "file" and path.extname(file_path) == ".luau" then
			table.insert(files, file_path)
		end
	end
end

const function module_id(file_path: string): string
	local namespace: string
	local relative_path: string
	if file_path:sub(1, 9) == "src/kern/" then
		namespace = "kern"
		relative_path = file_path:sub(10)
	else
		namespace = "cli"
		relative_path = file_path:sub(9)
	end

	const without_extension = relative_path:gsub("%.luau$", "")
	local without_init = without_extension:gsub("/init$", "")
	if without_init == "init" then
		without_init = ""
	end
	return if without_init == "" then `@{namespace}` else `@{namespace}/{without_init}`
end

const function source_files(): { string }
	local files = {}
	collect("src/kern", files)
	collect("src/cli/cmd", files)
	collect("src/cli/out", files)
	table.insert(files, "src/cli/init.luau")
	table.insert(files, "src/cli/types.luau")
	table.sort(files)
	return files
end

const function generate(): string
	local lines = {
		"--!strict",
		"-- Generated by scripts/generate_modules.luau. Do not edit.",
		"return {",
		`\tversion = "{VERSION}",`,
		"\tmodules = {",
	}

	for _, file_path in source_files() do
		table.insert(lines, `\t\t["{module_id(file_path)}"] = ` .. "{")
		table.insert(lines, `\t\t\tsource_path = "{file_path}",`)
		table.insert(lines, `\t\t\tsource = {quote(file_system.readFileToString(file_path))},`)
		table.insert(lines, "\t\t},")
	end

	table.insert(lines, "\t},")
	table.insert(lines, "}")
	return table.concat(lines, "\n") .. "\n"
end

file_system.writeStringToFile(OUTPUT_PATH, generate())
