--!strict

const file_system = require("@std/fs")
const path = require("@std/path")

const TYPE_ROOT = "types/kern"
const OUTPUT_PATH = "src/cli/gen/types.luau"

const function read_version()
	const version = file_system.readFileToString("VERSION"):gsub("^%s+", ""):gsub("%s+$", "")
	if version:match("^%d+%.%d+%.%d+[%w%.%-]*$") == nil then
		error(`kern: VERSION must contain a semantic version, got '{version}'`)
	end
	return version
end

const VERSION = read_version()

const function normalized(value): string
	const result = path.format(path.normalize(value)):gsub("\\", "/")
	return result
end

const function module_id(relative_path: string): string
	if relative_path == "init.luau" then
		return "@kern"
	end

	const without_extension = relative_path:gsub("%.luau$", "")
	local without_init = without_extension:gsub("/init$", "")
	return `@kern/{without_init}`
end

const function quote(source: string): string
	local equals = ""
	while source:find(`]{equals}]`, 1, true) ~= nil do
		equals ..= "="
	end
	return `[{equals}[{source}]{equals}]`
end

const function collect_tree(): ({ string }, { string })
	local files = {}
	local directories = {}

	const function visit(directory)
		table.insert(directories, normalized(directory))
		for _, entry in file_system.listDirectory(directory) do
			const file_path = normalized(path.join(directory, entry.name))
			if entry.type == "dir" then
				visit(file_path)
			elseif entry.type == "file" and path.extname(file_path) == ".luau" then
				table.insert(files, file_path)
			end
		end
	end

	visit(TYPE_ROOT)
	table.sort(files)
	table.sort(directories)
	return files, directories
end

const function luaurc_source(): string
	return '{\n  "languageMode": "strict"\n}\n'
end

const function package_luaurc_source(): string
	return table.concat({
		"{",
		'  "languageMode": "strict",',
		'  "aliases": {',
		'    "kern": "./kern",',
		'    "std": "~/.lute/typedefs/1.0.0/std"',
		"  }",
		"}",
		"",
	}, "\n")
end

const function generate(): string
	local lines = {
		"--!strict",
		"-- Generated by scripts/generate_types.luau. Do not edit.",
		"return {",
		`\tversion = "{VERSION}",`,
		"\tfiles = {",
	}

	local files, directories = collect_tree()
	for _, file_path in files do
		const relative_path = file_path:sub(#TYPE_ROOT + 2)
		const source = file_system.readFileToString(file_path)
		table.insert(lines, `\t\t["{module_id(relative_path)}"] = ` .. "{")
		table.insert(lines, `\t\t\tsource_path = "{file_path}",`)
		table.insert(lines, `\t\t\tsource = {quote(source)},`)
		table.insert(lines, "\t\t},")
	end

	for _, directory in directories do
		const config_path = `{directory}/.luaurc`
		table.insert(lines, `\t\t["config:{directory}"] = ` .. "{")
		table.insert(lines, `\t\t\tsource_path = "{config_path}",`)
		table.insert(lines, `\t\t\tsource = {quote(luaurc_source())},`)
		table.insert(lines, "\t\t},")
	end

	table.insert(lines, '\t\t["config:types"] = {')
	table.insert(lines, '\t\t\tsource_path = "types/.luaurc",')
	table.insert(lines, `\t\t\tsource = {quote(package_luaurc_source())},`)
	table.insert(lines, "\t\t},")

	table.insert(lines, "\t},")
	table.insert(lines, "}")
	return table.concat(lines, "\n") .. "\n"
end

file_system.writeStringToFile(OUTPUT_PATH, generate())
