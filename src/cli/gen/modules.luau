			error(`kern: entry '{entry}' is outside project root`, 2)
		end
		if seen[normalized] then
			error(`kern: duplicate project entry '{normalized}'`, 2)
		end

		seen[normalized] = true
		table.insert(copied, normalized)
	end

	return copied
